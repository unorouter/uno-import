# Gates the debug and echo routes. The import API takes no token.
API_TOKEN=dev

# Which origins a BROWSER may read a response from. Comma-separated exact
# origins, or "*" for any. Required: there is no default.
CORS_ORIGINS=http://localhost:3000,https://unorouter.com

# Saucepan needs a real account to serve cards.
SAUCEPAN_HANDLE=
SAUCEPAN_PASSWORD=

# Set to 1 to expose the /v1 echo endpoints used for JanitorAI proxy debugging.
DEBUG_ECHO=
